# API 서버 기본 URL. 실제 값은 .env(.local)에 복사해서 채운다.
VITE_API_BASE_URL=http://localhost:8080/api

# Notion 연동 — 서버(dev 프록시/Vercel 함수) 측 전용 변수. VITE_ 접두사를 붙이지 않는다
# (붙이면 클라이언트 번들에 토큰이 그대로 노출된다). 브라우저 코드에서는 접근할 수 없다.
# 설정 절차 전체는 README.md "Notion 설정" 섹션과 docs/notion-schema.md를 참고한다.
#
# Notion 통합(internal integration) 시크릿. notion.so/my-integrations에서 읽기 전용
# capability로 제한해 생성하고, 대상 데이터베이스와 공유(Connect)해야 조회가 가능하다.
NOTION_API_KEY=
# GET https://api.notion.com/v1/databases/{database_id} 응답의 data_sources[0].id 값.
NOTION_DATA_SOURCE_ID=

# Notion 바로가기 링크(v2, PRD 9장) — 용어 목록 화면에 "Notion에서 용어 추가" 버튼을 띄우기 위한
# 대상 URL. Notion 데이터베이스 "페이지"의 공개 URL일 뿐 통합 토큰 같은 비밀값이 아니므로,
# 위 두 변수와 달리 의도적으로 VITE_ 접두사를 붙여 클라이언트 번들에 노출되게 한다.
# 값이 비어 있으면 바로가기 버튼이 렌더링되지 않는다(선택 항목).
VITE_NOTION_DATABASE_URL=
